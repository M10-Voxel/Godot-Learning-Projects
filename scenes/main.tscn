[connection signal="pressed" from="ui/CanvasLayer/startScreen/PlayButton/ButtonPlay" to="ui" method="OnButtonPlayPressed"]
[connection signal="pressed" from="ui/CanvasLayer/chooseScreen/buttons/Ship1Button/ButtonShip1" to="ui" method="OnButtonShip1Pressed"]
[connection signal="pressed" from="ui/CanvasLayer/chooseScreen/buttons/Ship2Button/ButtonShip2" to="ui" method="OnButtonShip2Pressed"]
[connection signal="pressed" from="ui/CanvasLayer/chooseScreen/buttons/Ship3Button/ButtonShip3" to="ui" method="OnButtonShip3Pressed"]
[connection signal="pressed" from="ui/CanvasLayer/chooseScreen/buttons/SelectButton/ButtonSelect" to="ui" method="OnButtonSelectPressed"]
[connection signal="pressed" from="ui/CanvasLayer/inGameScreen/MuteButton/ButtonMute" to="ui" method="OnButtonMutePressed"]
[connection signal="pressed" from="ui/CanvasLayer/gameOverScreen/GameOverButton/ButtonGameOver" to="ui" method="OnButtonGameOverPressed"]
